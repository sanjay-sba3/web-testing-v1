# Copy to .env for manual runs (never commit .env). Every credential a test needs is read
# from here. Orbit writes this file itself on every generation run (the selected
# environment in the portal), so keep real values out of the repo.
APP_BASE_URL=https://your-app-under-test.example
APP_USERNAME=
APP_PASSWORD=
APP_OTP=
BROWSER=chromium
HEADLESS=true
STEP_TIMEOUT_MS=60000
